{
  "name": "stock-quant-system",
  "version": "1.0.0",
  "description": "Stock Quant System Web App",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "dev:engine": "cd apps/engine && uv run uvicorn app.main:app --reload --port ${PORT_ENGINE:-8000}",
    "dev": "bunx mprocs"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "mprocs": "^0.9.6"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "elysia": "^1.4.29"
  },
  "overrides": {
    "elysia": "1.4.29",
    "@elysiajs/eden": "1.4.9"
  }
}
