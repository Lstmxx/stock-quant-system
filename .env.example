# Hermes Agent Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM PROVIDER (OpenRouter)
# =============================================================================
# OpenRouter provides access to many models through one API
# All LLM calls go through OpenRouter - no direct provider keys needed
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# =============================================================================
# LLM PROVIDER (NovitaAI)
# =============================================================================
# NovitaAI — 90+ models, pay-per-use
# NOVITA_AI_API_KEY=

# =============================================================================
# GitHub Configuration
# =============================================================================
# GitHub Personal Access Token (for repo access)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
GITHUB_TOKEN=

# =============================================================================
# Feishu (Lark) Configuration
# =============================================================================
# Feishu App ID and Secret for bot integration
# Create at: https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Feishu Webhook URL for notifications (optional)
# FEISHU_WEBHOOK_URL=

# =============================================================================
# Data Sources
# =============================================================================
# baostock (A-share data) - no API key needed
# akshare (real-time data) - no API key needed
# tushare (alternative data source)
# TUSHARE_TOKEN=

# =============================================================================
# Proxy Configuration
# =============================================================================
# HTTP proxy for accessing external APIs
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# =============================================================================
# Notification Settings
# =============================================================================
# Default notification channel
# Options: feishu, telegram, discord, slack
# DEFAULT_NOTIFICATION_CHANNEL=feishu

# Telegram Bot Token (if using Telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord Webhook URL (if using Discord)
# DISCORD_WEBHOOK_URL=

# =============================================================================
# Quant Trading Configuration
# =============================================================================
# Default stock market
# Options: sh (Shanghai), sz (Shenzhen), hk (Hong Kong), us (US)
# DEFAULT_MARKET=sh

# Data cache directory
# DATA_CACHE_DIR=/opt/data/cache

# Report output directory
# REPORT_OUTPUT_DIR=/opt/data/daily_stock_analysis